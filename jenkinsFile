pipeline {
    agent any

    stages {

        stage('Build') {
            steps {
                echo 'Build and package the code using Maven'
            }
        }

        stage('Unit and Integration Tests') {
            steps {
                echo 'Run unit tests using JUnit'
                echo 'Run integration tests using JUnit'
            }
            post {
                always {
                    emailext(
                        to: 'malshansasindu502@gmail.com',
                        subject: "Jenkins - Unit and Integration Tests - ${currentBuild.currentResult}",
                        body: """Unit and Integration Tests stage completed.

Job: ${env.JOB_NAME}
Build Number: ${env.BUILD_NUMBER}
Stage: Unit and Integration Tests
Status: ${currentBuild.currentResult}

The Jenkins build log is attached to this email.""",
                        attachLog: true
                    )
                }
            }
        }

        stage('Code Analysis') {
            steps {
                echo 'Analyse the code using SonarQube'
            }
        }

        stage('Security Scan') {
            steps {
                echo 'Scan the code for vulnerabilities using OWASP Dependency-Check'
            }
            post {
                always {
                    emailext(
                        to: 'malshansasindu502@gmail.com',
                        subject: "Jenkins - Security Scan - ${currentBuild.currentResult}",
                        body: """Security Scan stage completed.

Job: ${env.JOB_NAME}
Build Number: ${env.BUILD_NUMBER}
Stage: Security Scan
Status: ${currentBuild.currentResult}

The Jenkins build log is attached to this email.""",
                        attachLog: true
                    )
                }
            }
        }

        stage('Deploy to Staging') {
            steps {
                echo 'Deploy the application to the staging server using AWS EC2'
            }
        }

        stage('Integration Tests on Staging') {
            steps {
                echo 'Run integration tests on the staging environment using JUnit'
            }
            post {
                always {
                    emailext(
                        to: 'malshansasindu502@gmail.com',
                        subject: "Jenkins - Integration Tests on Staging - ${currentBuild.currentResult}",
                        body: """Integration Tests on Staging stage completed.

Job: ${env.JOB_NAME}
Build Number: ${env.BUILD_NUMBER}
Stage: Integration Tests on Staging
Status: ${currentBuild.currentResult}

The Jenkins build log is attached to this email.""",
                        attachLog: true
                    )
                }
            }
        }

        stage('Deploy to Production') {
            steps {
                echo 'Deploy the application to the production server using AWS EC2'
            }
        }
    }
}
